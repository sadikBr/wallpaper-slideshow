<?xml version="1.0" encoding="utf-8"?>
<!--
  Three photo cards fanned out like a slideshow; the front one shows a landscape
  and three slideshow dots. Everything stays inside the adaptive-icon safe zone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Back card -->
    <group
        android:pivotX="54"
        android:pivotY="58"
        android:rotation="-14"
        android:translateX="-4">
        <path
            android:fillAlpha="0.35"
            android:fillColor="#FFFFFF"
            android:pathData="M42,34h24a5,5 0,0 1,5 5v34a5,5 0,0 1,-5 5h-24a5,5 0,0 1,-5 -5v-34a5,5 0,0 1,5 -5z" />
    </group>

    <!-- Middle card -->
    <group
        android:pivotX="54"
        android:pivotY="58"
        android:rotation="10"
        android:translateX="4">
        <path
            android:fillAlpha="0.6"
            android:fillColor="#FFFFFF"
            android:pathData="M42,34h24a5,5 0,0 1,5 5v34a5,5 0,0 1,-5 5h-24a5,5 0,0 1,-5 -5v-34a5,5 0,0 1,5 -5z" />
    </group>

    <!-- Front card -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M42,34h24a5,5 0,0 1,5 5v34a5,5 0,0 1,-5 5h-24a5,5 0,0 1,-5 -5v-34a5,5 0,0 1,5 -5z" />

    <!-- Picture -->
    <path android:pathData="M43,38h22a2.5,2.5 0,0 1,2.5 2.5v22.5h-27v-22.5a2.5,2.5 0,0 1,2.5 -2.5z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="40.5"
                android:startY="38"
                android:endX="67.5"
                android:endY="63">
                <item android:offset="0" android:color="@color/brand_indigo" />
                <item android:offset="0.6" android:color="@color/brand_violet" />
                <item android:offset="1" android:color="@color/brand_coral" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Sun -->
    <path
        android:fillColor="#FFD9A0"
        android:pathData="M60,45m-3.2,0a3.2,3.2 0,1 1,6.4 0a3.2,3.2 0,1 1,-6.4 0" />

    <!-- Mountains -->
    <path
        android:fillAlpha="0.92"
        android:fillColor="#FFFFFF"
        android:pathData="M40.5,63L49,51.5L54,57.5L58.5,52.5L67.5,61.5V63Z" />

    <!-- Slideshow dots -->
    <path
        android:fillColor="@color/brand_violet"
        android:pathData="M49.5,70.5m-1.7,0a1.7,1.7 0,1 1,3.4 0a1.7,1.7 0,1 1,-3.4 0" />
    <path
        android:fillColor="#D9D3F2"
        android:pathData="M54,70.5m-1.7,0a1.7,1.7 0,1 1,3.4 0a1.7,1.7 0,1 1,-3.4 0" />
    <path
        android:fillColor="#D9D3F2"
        android:pathData="M58.5,70.5m-1.7,0a1.7,1.7 0,1 1,3.4 0a1.7,1.7 0,1 1,-3.4 0" />
</vector>
